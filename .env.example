# Copy to .env and adjust. Never commit .env
# Spring Boot does not load .env automatically — export vars or use your IDE / Docker Compose.

# --- Shared secrets (MUST be the same across auth/user/client/package/courier) ---
JWT_SECRET=replace-with-a-long-random-string
INTERNAL_API_KEY=replace-with-a-long-random-string
JWT_EXPIRATION=3600000

# --- MySQL (override per service if needed) ---
MYSQL_USER=root
MYSQL_PASSWORD=
# Example per service when running one JVM:
# MYSQL_URL=jdbc:mysql://localhost:3306/authdb

# --- Eureka ---
EUREKA_URL=http://localhost:8761/eureka/

# --- Inter-service URLs (Eureka service ids; works with @LoadBalanced RestTemplate) ---
USER_SERVICE_URL=http://user-service
COURIER_SERVICE_URL=http://courier-service
AUTH_SERVICE_URL=http://auth-service

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Gateway CORS (tighten later; * is for local only) ---
CORS_ALLOWED_ORIGINS=*
